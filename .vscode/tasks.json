{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build all",
            "command": "C:/MinGW64/bin/g++.exe",
            "args": [
                "-Wall",
                "-fexceptions",
                "-fdiagnostics-color=always",
                "-I./include",
                "-g",
                "src/main.cpp",
                "src/DecisionTreeGame.cpp",
                "src/ScreenContext.cpp",
                "src/MainMenuScreen.cpp",
                "src/StoryScreen.cpp",
                "src/RulesScreen.cpp",
                "src/TechnicalInfoScreen.cpp",
                "src/ListScreen.cpp",
                "src/TreeScreen.cpp",
                "src/GameScreen.cpp",
                "src/GameOverScreen.cpp",
                "src/searchTree.cpp",
                "src/simpleList.cpp",
                "-o",
                "build/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds all project source files."
        }
    ],
    "version": "2.0.0"
}